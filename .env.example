# GEMINI_API_KEY: Required for Gemini AI API calls (e.g. AI Root Cause Analysis & FMEA recommendations)
# Automatically injected in AI Studio from user secrets.
GEMINI_API_KEY=""

# APP_URL: Host URL for this application instance
APP_URL="http://localhost:3000"

# Application Environment: development | staging | production
NODE_ENV="development"

# Server Port (fixed to 3000 by container proxy)
PORT=3000

# Authentication & Security Secrets
JWT_SECRET="enterprise-semiconductor-jwt-secret-replace-in-production"
SESSION_EXPIRY_HOURS="24"
CORS_ALLOWED_ORIGINS="*"

# Database Configuration (PostgreSQL in production / Embedded transactional engine in dev)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/semiconductor_intelligence"

# Telemetry Ingestion Rate Limiting
MAX_TELEMETRY_BATCH_SIZE="1000"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="1200"

# Industrial Connectors (Configuration Required for Live Mode)
MQTT_BROKER_URL="mqtt://industrial-broker.local:1883"
KAFKA_BROKERS="kafka-cluster-1.internal:9092,kafka-cluster-2.internal:9092"
OPCUA_ENDPOINT_URL="opc.tcp://opcua-server.fab-austin.local:4840"
